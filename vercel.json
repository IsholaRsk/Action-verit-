{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/post.html", "destination": "/post.html" },
    { "source": "/config.js", "destination": "/config.js" },
    { "source": "/app.js", "destination": "/app.js" },
    { "source": "/post.js", "destination": "/post.js" },
    { "source": "/style.css", "destination": "/style.css" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
